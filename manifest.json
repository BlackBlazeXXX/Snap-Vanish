{
  "manifest_version": 3,
  "name": "Snap Vanish",
  "version": "1.1.0",
  "description": "Snap your fingers on a video call and turn to dust. Runs entirely on your computer.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "offscreen"],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://teams.cloud.microsoft/*",
    "https://*.zoom.us/*",
    "https://*.zoom.com/*",
    "https://web.whatsapp.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Snap Vanish",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "snap-now": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Snap now (vanish or reappear)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.zoom.com/*",
        "https://web.whatsapp.com/*"
      ],
      "js": ["content/detector.js", "content/renderer.js", "content/main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.zoom.com/*",
        "https://web.whatsapp.com/*"
      ],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["engine/engine.html"],
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://teams.cloud.microsoft/*",
        "https://*.zoom.us/*",
        "https://*.zoom.com/*",
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'; connect-src 'self'; img-src 'self' data:;"
  }
}
